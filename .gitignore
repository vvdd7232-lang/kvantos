# --- intermediate build results ---
build/
sdk/build/
*.o
*.d
*.elf

# --- finished images: they are produced by make and attached to a release
#     as a separate archive, so as not to bloat the history ---
release/*.iso
release/*.img
release/*.bin
release/apps/*.kapp

# --- editor litter ---
*~
.*.swp
.DS_Store

# The release archive
kvantos-*.tar.gz

# The workflow lives in ci/ and is copied to .github/workflows by hand
.github/

# filesystem test artefacts: disk images and the reference blob are
# hundreds of megabytes and are rebuilt by tests/fs/mkimage.sh
tests/fs/build/
tests/fs/include/
tests/fs/mnt_bigdata.ref
