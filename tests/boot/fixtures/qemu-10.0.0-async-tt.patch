+/* Isolated LAB helper; this is routing validation, not a physical TT. */
+int usb_kvantos_lab_tt_route(USBDevice *dev, unsigned hub, unsigned port)
+{
+    USBPort *p = dev->port;
+    if (!p || p->ops != &usb_hub_port_ops) {
+        return 0;
+    }
+    USBHubState *s = p->opaque;
+    if (!object_dynamic_cast(OBJECT(s), "kvantos-lab-async-tt-hub")) {
+        return 0;
+    }
+    return s->dev.speed == USB_SPEED_HIGH && s->dev.addr == hub &&
+           p->index + 1 == port && (s->ports[p->index].wPortStatus & PORT_STAT_ENABLE) ? 1 : -1;
+}
